    "settings.butlerAuto": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto-send scans and voice notes"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拍照、录音的自动交给大管家"
          }
        }
      }
    },
    "settings.butlerNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The butler on your PC checks scans against the photo and sends back a clean copy. It goes through an encrypted mailbox in seconds, and falls back to the mirror folder. No AI keys on this phone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手写认不准的字，掌机上的大管家对着原图理顺再送回来。走 Cloudflare 信箱，几秒就到，信两头加密；信箱连不上才走镜像文件夹。手机上不存任何 AI 钥匙。"
          }
        }
      }
    },
    "settings.companion": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Buddy"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "陪玩"
          }
        }
      }
    },
    "settings.companionNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the toolbox at the top left, tap Buddy, pick Yiye, start. The ding means it’s listening: use your phone as usual and just ask out loud. Your words and the screen at that moment go to your own butler, which listens, looks, and answers out loud. The dot on the toolbox: green is listening, blinking means it hears you, orange is the butler on it, red is something broke (it’ll tell you what). The red and orange dots up top are Apple’s broadcast and mic lights. Normal."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "左上角工具箱里点「陪玩」，弹苹果的直播面板，选一叶笺，点开始。听到「叮」就是在听了：手机随便用，开口就问，它把你这句话和那一刻的屏幕交给自己的大管家，大管家听、看、用声音答你。工具箱右上角的小圆点：绿是在听，一闪一闪是听到你在说，橙是大管家在忙，红是哪儿坏了（它会念出来）。屏幕上方的红点、橙点是苹果的直播和麦克风提示，正常。"
          }
        }
      }
    },
