    "settings.butlerAuto": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto-send scans and voice notes"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拍照、录音的自动交给大管家"
          }
        }
      }
    },
    "settings.butlerNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scribbles the phone misreads go to your butler, who checks them against the photo and sends back a clean copy in seconds. Encrypted mailbox, locked at both ends; if it's down, the mirror folder takes over. Zero AI keys on this phone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手写认歪的字，交给大管家对着原图理顺，几秒后送回一份干净的。走加密信箱，两头上锁；信箱断了就走镜像文件夹。手机里一把 AI 钥匙都不放。"
          }
        }
      }
    },
    "settings.companion": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Buddy"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "陪玩"
          }
        }
      }
    },
    "settings.companionNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Toolbox, tap Buddy, Apple pops a broadcast panel, pick 一叶笺, start. A ding means it's listening: use your phone as usual and just ask out loud. It grabs the screen you asked about, hands it to your own butler, and answers out loud. Dots on the toolbox: green = listening, blinking = heard you, orange = butler's thinking, red = broke (it'll say what). Cut in any time, it shuts up. Say “二档 / 三档 / 四档” and it thinks harder, “回一档” to go back. “记住……” goes in its notebook. “派个活：……” it reads the job back, say “对” and it's dispatched. Deep talk: lock the phone with Buddy on, or tap Deep talk in the toolbox. No screen, just ask; it thinks a few minutes and reads you the answer; the full text lands in the 深聊 folder. Say “结束” to stop. The red and orange dots up top are Apple's broadcast lights. Relax."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工具箱里点「陪玩」，苹果弹出直播面板，选一叶笺，开始。听到「叮」就是它在听了，手机该干嘛干嘛，开口就问：它截下你问的那一屏，交给自家大管家，再用嘴回你。工具箱上的小点：绿＝在听，绿闪＝听见你了，橙＝大管家在想，红＝坏了（它会说坏在哪）。它说着你直接插嘴，它就闭嘴。喊「二档」「三档」「四档」想得更深，「回一档」回来。「记住……」它记进记事本。「派个活：……」它复述一遍，你说「对」就派出去。想深聊：陪玩开着锁屏，或点工具箱里的「深聊」，不截屏了，直接问，它想几分钟念给你，全文存进「深聊」文件夹；说「结束」收工。屏幕顶上的红点橙点是苹果在报备，别慌。"
          }
        }
      }
    },
    "settings.deskStale": {
      "extractionState": "manual",
