index d3d90b4..4a69492 100644
--- a/src/index.js
+++ b/src/index.js
@@ -10,7 +10,8 @@ const ROOM_RE = /^[A-Za-z0-9_-]{20,64}$/;
 const BATCH_RE = /^[A-Za-z0-9_-]{6,64}$/;
 
 import { handleCount, Quota } from './count.js';
-export { Quota };
